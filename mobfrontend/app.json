{
  "expo": {
    "name": "colllegeMedia",
    "slug": "colllegeMedia",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "colllegeMedia",
    "userInterfaceStyle": "automatic",
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.veereshkunakere.mobfrontend",
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser",
      "expo-sqlite",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar",
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "171c655d-8eaa-4fe1-90e8-9ec6a2d68c94"
      }
    }
  }
}
